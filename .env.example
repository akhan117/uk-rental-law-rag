# Copy to .env (git-ignored). docker compose reads it automatically; for the dev
# server use `uvicorn main:app --env-file ../.env` from backend/. Every variable
# is optional and blank means unset; the defaults reproduce the original local
# setup (Ollama + qwen3:4b).

# --- LLM backend (backend/llm.py) -------------------------------------------
# ollama (default) | groq | gemini | openrouter | openai (any OpenAI-compatible URL)
LLM_PROVIDER=ollama
# Blank = the provider's default: qwen3:4b, openai/gpt-oss-20b (groq),
# gemini-2.5-flash (gemini), openai/gpt-oss-20b:free (openrouter)
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# For LLM_PROVIDER=openai, or to point a preset elsewhere
LLM_BASE_URL=
LLM_API_KEY=
OLLAMA_URL=http://localhost:11434
# Seconds. Default 600 for Ollama (slow CPU-only machines), 60 for hosted.
RAG_TIMEOUT=
# schema_strict | schema | json_object | none - starting rung of the structured-output ladder
LLM_JSON_MODE=schema_strict
# List price per 1M tokens, for the cost-per-answer estimate on /metrics/summary
LLM_PRICE_IN_PER_M=0
LLM_PRICE_OUT_PER_M=0

# --- Agent mode (backend/agent.py) ------------------------------------------
AGENT_PLAN_MAX_TOKENS=600

# --- Public-demo guards (backend/guard.py); 0 = off ---------------------------
RATE_LIMIT_PER_MINUTE=0
DAILY_QUERY_LIMIT=0
ANSWER_CACHE_SIZE=256
ANSWER_CACHE_TTL_S=86400

# --- Data -------------------------------------------------------------------
# Alternative corpus directory (holds processed/ and chroma/)
RAG_DATA_DIR=
# Chroma's usage telemetry: off (it fails noisily with this chromadb version)
ANONYMIZED_TELEMETRY=False
